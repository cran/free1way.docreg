%  + \left( A(\hat{\eshiftparm}, \hat{\parm})_{\eshiftparm, \eshiftparm}^{\nicefrac{1}{2}} 
%    S^\prime_\eshiftparm(\hat{\eshiftparm}, \hat{\parm})
%  +  A^\prime(\hat{\eshiftparm}, \hat{\parm})_{\eshiftparm, \eshiftparm}^{\nicefrac{1}{2}}
%    S_\eshiftparm(\hat{\eshiftparm}, \hat{\parm}) \right) 
%    (\eshiftparm_0 - \hat{\eshiftparm}) \\
%& \stackrel{S_\eshiftparm(\hat{\eshiftparm}, \hat{\parm}) = 0}{=} & 
