\Keywords{Area under the ROC curve, Distribution-free oneway layout, Empirical likelihood,
Probabilistic index, Proportional odds model, Stratification, Transformation model}
\Plainkeywords{Area under the ROC Curve, Distribution-free oneway layout, Empirical likelihood,
Probabilistic index, Proportional odds model, Stratification, Transformation model}

\Address{
