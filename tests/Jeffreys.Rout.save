> ### repeated measures
> d <- rfree1way(n = 1, blocks = 25, delta = 1)
> d$y <- factor(d$y < .5)
> 
> ft <- free1way(y ~ groups | blocks, data = d, logdet = TRUE)
> 
> H <- get("he", envir = environment(ft$profile))(ft$par)
> all.equal(unname(c(ft$logdet)), 
+                  c(determinant(as.matrix(H), log = TRUE)$modulus))
[1] TRUE
